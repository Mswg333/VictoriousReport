# Kopiraj ovaj fajl u .env i popuni. Fajl .env nikad ne ide u git.

# OAuth klijent iz Google Cloud projekta "Victorious Portal"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Koje Google Ads naloge portal cita. Dva nacina:
#
# 1) Samo odredjeni nalozi (za probu na jednom nalogu): upisi njihove ID-jeve,
#    odvojene zarezom. Portal tada cita iskljucivo njih.
GOOGLE_ADS_ACCOUNT_IDS=
#
# 2) Svi aktivni nalozi ispod MCC-a: ostavi gornji red prazan i upisi ID MCC-a.
#
# Ako tom nalogu pristupas preko MCC-a (najcesci slucaj), ID MCC-a upisi i uz
# nacin 1: on tada sluzi samo kao "ulaz", spisak naloga iz MCC-a se ne ucitava.
GOOGLE_ADS_MCC_ID=

# Ko sme da se prijavi: Google nalozi sa ovog domena
ALLOWED_DOMAIN=victorious.rs

# Opciono: samo ovi emailovi (odvojeni zarezom). Prazno = svi sa domena.
ALLOWED_EMAILS=

# Samo na serveru (lokalno se pravi sam, u fajlu .secret_key):
# SECRET_KEY=
# DATABASE_URL=

# ---- Ostali kanali (svaki je opcion; prazno = kanal se ne koristi) ----

# Meta Ads: App ID i App secret aplikacije (developers.facebook.com,
# App settings > Basic). Tada clanovi tima povezuju svoj Facebook nalog
# dugmetom u portalu. Bez ovoga token moze samo da se nalepi rucno.
META_APP_ID=
META_APP_SECRET=
# Samo za aplikacije tipa Business (Facebook Login for Business): ID konfiguracije
META_LOGIN_CONFIG_ID=

# Microsoft Ads (Bing): aplikacija iz Microsoft Entra (Azure) i developer token
MICROSOFT_ADS_CLIENT_ID=
MICROSOFT_ADS_CLIENT_SECRET=
MICROSOFT_ADS_DEVELOPER_TOKEN=

# TikTok Ads: aplikacija sa TikTok API for Business portala
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
